# ------------------------------------------------------------
# Genisys Hub — environment variables
#
# Copy this file to `.env.local` for local dev.
# In production (Render), paste the same keys into
# Render → Environment tab. Never commit a filled-in version.
# ------------------------------------------------------------

# --- Database (Render Postgres) ---
# Local: use the "External Connection" string from Render, OR run a local Postgres.
# Production: Render will inject this automatically if you use its managed Postgres.
DATABASE_URL="postgresql://user:password@host:5432/genisys_hub"

# --- Auth.js (NextAuth) ---
# Generate a random 32-byte secret: `openssl rand -base64 32`
# or Node: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""
# In dev: http://localhost:3000
# In prod: https://hub.leadgenisys.com (or whatever hostname Render gives you)
AUTH_URL="http://localhost:3000"

# --- Google OAuth (for SSO + Gmail + Calendar) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
# Scopes added dynamically when a user connects their Gmail/Calendar.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Vault master key ---
# 32 random bytes, base64 encoded. Used to encrypt API keys in the vault.
# If you lose this, all vault entries become unrecoverable. Back it up.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
VAULT_MASTER_KEY=""

# --- Twilio (for morning SMS reminders) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+18772573649"

# --- Anthropic (AI drafts, lead scoring) ---
ANTHROPIC_API_KEY=""

# --- GoHighLevel (Private Integration tokens, one per sub-account) ---
# You'll paste 4 tokens — one for the Genisys sub-account and one per client.
# These are also stored in the in-app vault once it's built; env vars are for
# bootstrapping and for server-side code that needs them before the user logs in.
GHL_GENISYS_TOKEN=""
GHL_CLIENT_1_TOKEN=""
GHL_CLIENT_2_TOKEN=""
GHL_CLIENT_3_TOKEN=""

# --- Notion ---
NOTION_API_KEY=""

# --- Slack (populated when we wire up Slack integration) ---
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_APP_TOKEN=""

# --- Domain restriction for SSO ---
# Comma-separated list. Only users whose Google email ends in one of these
# domains can log into the hub. Keep `trustware.io` so Ethan can use his work
# account for the Trustware calendar, if you want that flow.
AUTH_ALLOWED_DOMAINS="leadgenisys.com,trustware.io"
