# ------------------------------------------------------------
# Genisys Hub — environment variables
#
# Copy this file to `.env.local` for local dev.
# In production (Render), paste the same keys into
# Render → Environment tab. Never commit a filled-in version.
# ------------------------------------------------------------

# --- Database (Render Postgres) ---
# Local: use the "External Connection" string from Render, OR run a local Postgres.
# Production: Render will inject this automatically if you use its managed Postgres.
DATABASE_URL="postgresql://user:password@host:5432/genisys_hub"

# --- Auth.js (NextAuth) ---
# Generate a random 32-byte secret: `openssl rand -base64 32`
# or Node: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""
# In dev: http://localhost:3000
# In prod: https://hub.leadgenisys.com (or whatever hostname Render gives you)
AUTH_URL="http://localhost:3000"

# --- Google OAuth (for SSO + Gmail + Calendar) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
# Scopes added dynamically when a user connects their Gmail/Calendar.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Vault master key ---
# 32 random bytes, base64 encoded. Used to encrypt API keys in the vault.
# If you lose this, all vault entries become unrecoverable. Back it up.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
VAULT_MASTER_KEY=""

# --- Twilio (for morning SMS reminders) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+18772573649"

# --- Anthropic (AI drafts, lead scoring) ---
ANTHROPIC_API_KEY=""

# --- GoHighLevel (Private Integration tokens, one per sub-account) ---
# You'll paste 4 tokens — one for the Genisys sub-account and one per client.
# These are also stored in the in-app vault once it's built; env vars are for
# bootstrapping and for server-side code that needs them before the user logs in.
GHL_GENISYS_TOKEN=""
GHL_CLIENT_1_TOKEN=""
GHL_CLIENT_2_TOKEN=""
GHL_CLIENT_3_TOKEN=""

# --- Notion ---
NOTION_API_KEY=""

# --- Slack ---
# Channel the Hub posts to, without a #. The bot must already be in it.
# #genisys-alerts is not visible to the bot, so set this before relying on alerts.
# HUB_ALERT_CHANNEL=your-channel-name

SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_APP_TOKEN=""

# --- GHL sub-account browser worker (off unless you turn it on) ---
# Creates a sub-account through the agency dashboard, because the API
# refuses creation on Agency Unlimited. Runs inside the existing
# genisys-hub service (native Node, 1 CPU / 2 GB). One browser at a
# time, closed when the job finishes. Nothing runs until ENABLED is
# on/true/1/yes. Even then it fills the form and stops (dry run) until
# MODE=create.
#
# On Render, `npm run build` downloads Chromium only when RENDER=true
# (Render sets that) and this flag is on. Local builds and CI skip it.
# You do not set PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD or
# PLAYWRIGHT_BROWSERS_PATH. The install script and the launch code set
# the browsers path themselves.
#
# GHL_SUBACCOUNT_WORKER_ENABLED=0
# GHL_SUBACCOUNT_WORKER_MODE=dry_run
# Set to 1 to stop this process claiming jobs while a fix is deployed.
# Create mode can stay on; nothing is submitted until this is unset.
# GHL_SUBACCOUNT_WORKER_PAUSED=1
# Boot splits only these intake ids onto their own client and job.
# Unset keeps Snapshot Check LLC (cmwd3jnao001m3hsct1totiqp). Set empty
# to backfill nothing. This is not a sweep of every intake.
# GHL_BACKFILL_INTAKE_IDS=cmwd3jnao001m3hsct1totiqp
# GHL_SUBACCOUNT_WORKER_RUN=1
# GHL_SUBACCOUNT_WORKER_HEADLESS=1
# GHL_AGENCY_DASHBOARD_URL=https://app.gohighlevel.com
# Optional. Used only if clicking the Sub-Accounts nav does not open the list.
# GHL_SUBACCOUNT_LIST_URL=
# The snapshot card title in the Select Snapshot Template modal. Exact match,
# ignoring case and surrounding spaces. This is the name the browser looks for.
# Settings → GHL sub-accounts stores a snapshot ID, not this title. If this is
# empty, the worker asks the agency API for the name of that ID.
# GHL_SUBACCOUNT_SNAPSHOT_NAME=Master Template
# Optional. Overrides the snapshot id stored on a queued job and in
# Settings → GHL sub-accounts. Use this when the payload still has an
# older id. If unset, a listed snapshot whose name matches
# GHL_SUBACCOUNT_SNAPSHOT_NAME wins over that stale id.
# GHL_SUBACCOUNT_SNAPSHOT_ID=PsOYVeuIfXR7soMIiMcI
# Optional tab to open first. After that: Imported Snapshots, My Snapshots,
# Snapshot Templates.
# GHL_SUBACCOUNT_SNAPSHOT_TAB=Imported Snapshots
# Login. Either these two, or a Vault entry "GHL Agency Dashboard Login"
# whose value is {"email":"...","password":"..."} .
# GHL_AGENCY_EMAIL=
# GHL_AGENCY_PASSWORD=
# The snapshot dropdown's name. If empty, the worker asks the agency
# key for the name of the snapshot id in Settings → GHL sub-accounts.
# GHL_SUBACCOUNT_SNAPSHOT_NAME=
# Optional JSON wording overrides if GHL renames a button or field.
# GHL_SUBACCOUNT_WORKER_LABELS=
# Webhook secret for POST /api/webhooks/ghl-subaccount-worker.
# If empty, the Vault entry "GHL Subaccount Worker Webhook Secret" is
# used, then "Client Onboarding Webhook Secret".
# GHL_SUBACCOUNT_WORKER_WEBHOOK_SECRET=
# Optional: read the security code from the Google Workspace mailbox
# that already receives it (the et***@leadgenisys.com inbox). No extra
# user. Leave these unset and the worker waits for a code pasted in
# Settings for the rest of the 12 minutes.
#
# Setup on that existing mailbox:
# 1. Turn on 2-Step Verification for that Google account.
# 2. A Workspace admin allows app passwords (Admin console → Security
#    → Authentication → 2-step verification → allow users to generate
#    app passwords) and allows Gmail IMAP.
# 3. In Gmail for that mailbox: Settings → See all settings →
#    Forwarding and POP/IMAP → Enable IMAP → Save.
# 4. Google Account → Security → App passwords → create one named
#    "Genisys Hub". The 16-character password is GHL_OTP_IMAP_PASSWORD.
#    It is not the account password.
# 5. GHL_OTP_IMAP_USER is the full address of that mailbox, the same
#    address GHL emails the code to. GHL_AGENCY_EMAIL should be that
#    same address when that person is the agency login.
# The worker reads INBOX and [Gmail]/All Mail. It keeps a HighLevel
# security-code message from about 2 minutes before Send onward
# (clock skew). It does not mark mail read and it does not delete.
# Each poll is written to the job log: connect, mailbox, search counts,
# and why each message was kept or skipped. Passwords and the code
# itself are not written there.
# GHL_OTP_IMAP_HOST=imap.gmail.com
# GHL_OTP_IMAP_PORT=993
# GHL_OTP_IMAP_USER=
# GHL_OTP_IMAP_PASSWORD=
# Only for the optional Docker fallback (docker/ghl-subaccount-worker.Dockerfile),
# which already has Chromium's libraries. Also set RUN=0 on the web service.
# GHL_SUBACCOUNT_CHROMIUM=system
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# --- Domain restriction for SSO ---
# Comma-separated list. Only users whose Google email ends in one of these
# domains can log into the hub. Keep `trustware.io` so Ethan can use his work
# account for the Trustware calendar, if you want that flow.
AUTH_ALLOWED_DOMAINS="leadgenisys.com,trustware.io"
