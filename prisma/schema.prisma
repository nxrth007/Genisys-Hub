// Genisys Hub — Prisma schema (Postgres)
//
// Run `npm run prisma:migrate` to apply schema changes locally.
// Run `npm run prisma:deploy` in production (Render) to run pending migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7, url lives in prisma.config.ts. The Prisma client uses the
  // @prisma/adapter-pg driver adapter (see src/lib/prisma.ts).
}

// -----------------------------------------------------------------------------
// Auth.js (NextAuth v5) standard tables
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  // Roles:
  //   member        — staff, default for Google SSO signups
  //   admin         — staff with admin privileges (first user, or promoted)
  //   agent_pending — registered but awaiting approval (no access yet)
  //   agent         — approved call-center agent, can access /agent only
  //   agent_denied  — registration denied
  role          String    @default("member")
  // For Credentials-auth users (agents). Null for Google SSO users.
  passwordHash  String?
  // Which tab title was created in the master appointments spreadsheet for
  // this agent (set when their registration is approved). Null otherwise.
  agentSheetTab String?
  // When the agent was approved. Null for pending / denied / staff.
  approvedAt    DateTime?
  approvedById  String?
  timezone      String    @default("America/New_York")
  phoneNumber   String?   // E.164, used for SMS reminders
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  calendarConnections CalendarConnection[]
  tasks               Task[]
  scheduledSms        ScheduledSms[]
  vaultCreated        VaultEntry[]        @relation("VaultEntryCreator")
  vaultAccessLogs     VaultAccessLog[]
  appointments        Appointment[]       @relation("AgentAppointments")
  eodReports          EodReport[]         @relation("AgentEodReports")
  callbacks           Callback[]          @relation("AgentCallbacks")
  documentsUploaded   Document[]          @relation("DocumentUploader")
  documentFoldersCreated DocumentFolder[] @relation("DocumentFolderCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Email / inbox (ported from Pf Hub, trimmed for Genisys)
// -----------------------------------------------------------------------------

model GmailAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  tokenExpiry  DateTime
  historyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emails Email[]
}

model Email {
  id             String       @id @default(cuid())
  gmailMessageId String       @unique
  threadId       String?
  accountId      String
  account        GmailAccount @relation(fields: [accountId], references: [id])
  from           String
  fromName       String?
  to             String
  subject        String
  bodyText       String?      @db.Text
  bodyHtml       String?      @db.Text
  snippet        String?
  date           DateTime
  folder         String       @default("inbox")
  isRead         Boolean      @default(false)
  isLead         Boolean      @default(false)
  leadConfidence Float?
  category       String?
  classifiedAt   DateTime?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  drafts         DraftReply[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accountId, date])
  @@index([isLead])
  @@index([folder])
}

model DraftReply {
  id            String    @id @default(cuid())
  emailId       String
  email         Email     @relation(fields: [emailId], references: [id])
  body          String    @db.Text
  status        String    @default("draft") // draft | approved | sent
  autoGenerated Boolean   @default(false)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model Lead {
  id           String    @id @default(cuid())
  name         String?
  email        String?   @unique
  phone        String?
  company      String?
  serviceType  String? // "roofing" | "solar" | other
  zip          String?
  status       String    @default("new") // new | contacted | booked | closed_won | closed_lost
  source       String    @default("email") // email | ad | cold_call | referral
  ghlContactId String?
  ghlSubId     String? // which GHL sub-account owns this lead
  notes        String?   @db.Text
  emails       Email[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// Google Drive — per-mailbox connections (alex@, ethan@leadgenisys.com)
// -----------------------------------------------------------------------------

model DriveAccount {
  id             String    @id @default(cuid())
  email          String    @unique
  accessToken    String    @db.Text
  refreshToken   String    @db.Text
  tokenExpiry    DateTime
  // Reserved for future incremental sync via Drive Changes API.
  startPageToken String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// GoHighLevel — 4 sub-accounts
// -----------------------------------------------------------------------------

model GhlSubAccount {
  id          String   @id @default(cuid())
  name        String // "Genisys", "Client — Acme Roofing", etc.
  locationId  String   @unique // GHL locationId
  tokenVaultId String? // points at a VaultEntry that holds the Private Integration token
  isOwnAgency Boolean  @default(false) // true for the Genisys sub, false for clients
  color       String   @default("#3b82f6") // for sidebar grouping
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Calendar connections — Google Workspace (leadgenisys.com) + Trustware for Ethan
// -----------------------------------------------------------------------------

model CalendarConnection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "google" | "ical" (fallback if OAuth blocked)
  label        String // "Genisys Workspace", "Trustware", etc.
  email        String? // Google account email for this connection
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  tokenExpiry  DateTime?
  icalUrl      String?  @db.Text // used when provider = "ical"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Today page — tasks + scheduled SMS briefs
// -----------------------------------------------------------------------------

model Task {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  notes      String?   @db.Text
  dueAt      DateTime?
  completedAt DateTime?
  priority   String    @default("normal") // low | normal | high
  notionPageId String? // if synced to a Notion page
  ghlOpportunityId String? // if synced to a GHL opportunity
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, dueAt])
  @@index([userId, completedAt])
}

model ScheduledSms {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  timeOfDay String // "07:00" in the user's timezone
  // Delivery channel:
  //   slack    — DM via Slack (default, needs the user to be in the workspace)
  //   ghl_sms  — SMS via the GHL Private Integration token (needs recipientPhone)
  channel   String   @default("slack")
  // Destination phone when channel=ghl_sms. Falls back to User.phoneNumber.
  recipientPhone  String?
  // Optional Notion assignee to filter the task board by (e.g. "Ethan"). When
  // set, the brief's task section is drawn from the pinned Notion Kanban's
  // "To Do"-ish column, restricted to tasks assigned to this name, instead of
  // the user's local Task rows.
  notionAssignee  String?
  // Timezone for the schedule (IANA). When set, overrides the schedule
  // owner's User.timezone so the brief fires at the recipient's local time,
  // not the admin's. Crucial when the admin and recipient are in different
  // time zones (e.g., Alex in ET scheduling a brief for Ethan in PT).
  timezone        String?
  includeTasks    Boolean @default(true)
  includeMeetings Boolean @default(true)
  lastSentAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Vault — encrypted API keys, shared across the team
// -----------------------------------------------------------------------------

model VaultEntry {
  id            String   @id @default(cuid())
  name          String // "GHL • Genisys", "Anthropic", etc.
  description   String?  @db.Text
  ciphertext    Bytes // encrypted secret value
  nonce         Bytes // 24-byte nonce for XChaCha20-Poly1305
  tags          String[] // for grouping in UI
  createdById   String
  createdBy     User     @relation("VaultEntryCreator", fields: [createdById], references: [id])
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accessLogs VaultAccessLog[]

  @@index([name])
}

model VaultAccessLog {
  id        String      @id @default(cuid())
  entryId   String
  entry     VaultEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    String // "view" | "edit" | "delete" | "create"
  createdAt DateTime    @default(now())

  @@index([entryId, createdAt])
  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Slack — stubs, wired later
// -----------------------------------------------------------------------------

model SlackWorkspace {
  id         String   @id @default(cuid())
  teamId     String   @unique
  teamName   String
  accessToken String  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  channels SlackChannel[]
}

model SlackChannel {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       SlackWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId       String
  channelName     String
  isMonitored     Boolean       @default(false) // only pull messages for channels the user cares about
  lastMessageTs   String?
  clientName      String? // optional label: "Acme Roofing" etc.

  messages SlackMessage[]

  @@unique([workspaceId, channelId])
}

model SlackMessage {
  id          String       @id @default(cuid())
  channelId   String
  channel     SlackChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slackTs     String // Slack's message timestamp, unique per channel
  userSlackId String
  userName    String?
  text        String       @db.Text
  threadTs    String? // for threaded replies
  isOurReply  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@unique([channelId, slackTs])
  @@index([channelId, createdAt])
}

// -----------------------------------------------------------------------------
// Misc
// -----------------------------------------------------------------------------

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

// -----------------------------------------------------------------------------
// Documents — simple internal file storage for contracts, signed agreements,
// and other important documents shared between staff. Files stored directly
// in Postgres (bytea) so there's no extra infra / object store to manage.
// Separate from the Google Drive module (that reads your personal Drive; this
// is a self-contained Hub store). Staff-only access.
// -----------------------------------------------------------------------------

model DocumentFolder {
  id          String           @id @default(cuid())
  name        String
  // Null parentId = root-level folder. Cascade so deleting a parent
  // removes its child folders (and by extension the documents inside).
  parentId    String?
  parent      DocumentFolder?  @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DocumentFolder[] @relation("DocumentFolderTree")
  documents   Document[]
  createdById String
  createdBy   User             @relation("DocumentFolderCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([parentId])
}

model Document {
  id           String          @id @default(cuid())
  // Null folderId = root (no folder). Cascade so deleting a folder takes
  // its documents with it.
  folderId     String?
  folder       DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  sizeBytes    Int
  content      Bytes           // raw file bytes
  uploadedById String
  uploadedBy   User            @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([folderId])
}

// -----------------------------------------------------------------------------
// Call-center appointments — booked by agents via /agent portal.
// One row per appointment; synced to the master spreadsheet (one row in the
// agent's personal tab + one row in the master rollup tab).
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// Clients — the Genisys agency books appointments on behalf of multiple
// solar companies. Each appointment must identify which client it belongs to
// so we can split reporting + sheet sync correctly. Seeded at migration time
// (Brighton Capital Solar, Spring Solar); new clients added via SQL/Prisma
// Studio for now — no admin UI yet.
// -----------------------------------------------------------------------------

model Client {
  id           String   @id @default(cuid())
  name         String   @unique
  state        String? // e.g. "Arizona", "Utah" — for agent context only
  color        String   @default("#3b82f6") // hex for badges
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ---- Relationship + contact details ------------------------------------
  // Free-form text so admins can paste whatever the client cares about
  // without a schema migration each time. All optional — the create
  // flow stays fast for cases where these aren't known yet.
  contactName     String? // primary human contact ("David Mehta")
  contactRole     String? // their role ("VP Revenue", "COO")
  contactEmail    String?
  contactPhone    String? // stored canonical-formatted ("(555) 123-4567")
  address         String?
  notes           String? // long-form, multi-line — markdown-ish OK
  intakeFormUrl   String?
  ghlSubaccountUrl String?

  // Lifecycle status — richer than the boolean `active`. Valid values:
  //   "active"       — engaged + booking
  //   "onboarding"   — in setup, not yet receiving bookings
  //   "paused"       — temporarily on hold
  //   "churned"      — relationship ended (kept for historical reporting)
  // The legacy `active` flag still gates list visibility for now so
  // agents don't see churned clients in their booking picker.
  lifecycle       String   @default("active")

  appointments      Appointment[]
  reminderTemplates ReminderTemplate[]
  appointmentReminders AppointmentReminder[]
}

model Appointment {
  id              String   @id @default(cuid())
  agentUserId     String
  agent           User     @relation("AgentAppointments", fields: [agentUserId], references: [id], onDelete: Cascade)

  // Which client the appointment is booked for. Nullable so historical
  // rows (pre-Client-feature) don't need backfill; required enforced in
  // the POST /api/agent/appointments handler for new bookings.
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Booking details — matches the fields the call center currently records.
  apptDateTime    DateTime
  customerName    String
  customerPhone   String
  address         String?
  email           String?
  monthlyBill     String?
  utilityProvider String?
  roofType        String?
  roofAge         String?
  status          String   @default("booked") // booked | rescheduled | showed | no_show | cancelled
  estimatedDealValue String?
  notes           String?  @db.Text
  callRecordingLink String?

  // Google Sheets sync tracking — row numbers in the agent's tab and the
  // master rollup tab. Null until first sync succeeds; populated after so
  // subsequent edits update the existing rows instead of duplicating.
  agentSheetRowNumber  Int?
  masterSheetRowNumber Int?
  lastSyncedAt         DateTime?
  syncError            String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders AppointmentReminder[]

  @@index([agentUserId, createdAt])
  @@index([status])
  @@index([apptDateTime])
  @@index([clientId])
}

// -----------------------------------------------------------------------------
// SMS appointment reminders. The Hub sends per-appointment SMS reminders to
// customers via the GHL API (1 day before, 2 hr before, 30 min before, and
// at appointment start). One row per (appointment, reminder type) — synced
// from the master spreadsheet on every scheduler tick so manual sheet
// entries get reminders too, not just Hub-booked rows.
//
// Past appointments are guarded — reminders whose `scheduledFor` is already
// in the past at insert time get marked `skipped` immediately so the
// dispatcher never accidentally fires "your appointment is starting" two
// weeks late.
// -----------------------------------------------------------------------------

model AppointmentReminder {
  id              String   @id @default(cuid())

  // Source of truth — exactly one of these resolves to the appointment:
  //   1. appointmentId for Hub-booked rows (preferred when available)
  //   2. sheetTabTitle + sheetRowNumber for sheet-only rows
  // Both are persisted when known so a sheet-row that later picks up
  // a DB ID stays linkable.
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sheetTabTitle   String?
  sheetRowNumber  Int?

  // Composite source key — "db:cuid" or "sheet:Master Table:42" — used
  // for the unique index alongside reminderType. Stable per appointment
  // so re-syncs upsert instead of duplicating.
  sourceKey       String

  // Which window this reminder is for. One of: "1day" | "2hr" | "30min"
  // | "start". Strings instead of an enum so adding new windows later
  // is just a config change.
  reminderType    String

  // UTC moment the reminder should fire. Computed at row-create time
  // from apptDateTime + customerTimezone, then never recomputed —
  // edits to the source row trigger a re-sync that produces a fresh
  // reminder row (the old one gets cancelled).
  scheduledFor    DateTime

  // Snapshots so we can render the SMS even if the source row is
  // edited / deleted between sync and dispatch. Keeps the message
  // body stable + audit trail honest.
  customerName    String
  customerPhone   String
  customerTimezone String
  apptDateTime    DateTime
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName      String?  // business name (Client.name)
  clientContactName String? // primary human contact (Client.contactName)
  address         String?
  agentName       String?

  // Send tracking. Lifecycle: pending → sending → sent | failed.
  // Skipped = past-due at create time (we never even tried). Cancelled
  // = the source row went away or got marked cancelled before fire.
  status          String   @default("pending")
  sentAt          DateTime?
  errorMessage    String?  @db.Text
  ghlContactId    String?
  ghlMessageId    String?
  ghlConversationId String?

  // Final rendered body — captured at send time so the SMS log shows
  // exactly what the customer received, even if a template is later
  // edited.
  messageBody     String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceKey, reminderType], map: "ux_reminder_source_type")
  @@index([scheduledFor, status])
  @@index([appointmentId])
  @@index([clientId])
  @@index([status, sentAt])
}

// Per-(client, reminderType) message body. Falls back to the
// hardcoded defaults in lib/reminders.ts when no template is set —
// so the system works out of the box and admins only edit what they
// want to override. clientId=null is the global default override
// (rarely used in practice, but lets us flip default copy without
// touching code).
model ReminderTemplate {
  id           String   @id @default(cuid())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reminderType String

  body         String   @db.Text
  enabled      Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, reminderType], map: "ux_template_client_type")
}

// Singleton config for the SMS-reminder system. Master enable + which
// vault entry's GHL JWT token to use for sending. id is hardcoded to
// "singleton" so it's always upsertable with a known key.
model RemindersConfig {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  vaultEntryName  String   @default("GHL Genisys Token")
  // Cap how far ahead we'll create reminder rows. Anything further
  // out gets re-evaluated on the next sync. Default 10 days covers
  // the 1-day-out window with margin to spare.
  lookaheadDays   Int      @default(10)
  // TCPA compliance — don't send SMS outside these hours (in the
  // *customer's* local timezone, derived from address state).
  // 24-hour format "HH:mm". Defaults align with the TCPA window
  // (8 AM – 9 PM). The dispatcher checks before sending; reminders
  // that land outside the window are deferred until the next allowed
  // moment by skipping that tick (they retain status='pending' and
  // get retried on the next minute).
  quietHoursStart String   @default("21:00")
  quietHoursEnd   String   @default("08:00")
  updatedAt       DateTime @updatedAt @default(now())
}

// -----------------------------------------------------------------------------
// End-of-day reports — submitted by agents at the end of each shift.
// One row per (agent, reportDate). Agents can re-open and update their own
// submission for the current day; staff view across all agents on
// /call-center. Fields mirror what Ethan asked for in the 2026-04-20 chat:
// dials, live contacts, appointments generated, issues faced, plus a bit
// more structured signal (callbacks, tech-issue tags) so patterns surface
// across days without requiring everyone to re-type the same complaints.
// -----------------------------------------------------------------------------

model EodReport {
  id                    String   @id @default(cuid())
  agentUserId           String
  agent                 User     @relation("AgentEodReports", fields: [agentUserId], references: [id], onDelete: Cascade)

  // Shift day (date-only in agent's local timezone). Stored as DATE so two
  // rows for the same calendar day can't exist for one agent.
  reportDate            DateTime @db.Date

  // Core metrics Ethan called out.
  dialsMade             Int      @default(0)
  contactsReached       Int      @default(0) // live conversations
  appointmentsGenerated Int      @default(0) // agent's own count; reconciled against Appointment table in UI
  callbacksScheduled    Int      @default(0)

  // Technical issue classification. Tags chosen from a known set in the UI
  // (dialer, CRM, Hub, call recording, connectivity, other); freeform notes
  // explain the specifics. Using String[] instead of a join table — we don't
  // need to query by tag at scale and this keeps the form dead simple.
  technicalIssueTags    String[]
  technicalIssueNotes   String?  @db.Text

  // Organizational / process blockers (leadership, shift handoff, unclear
  // scripts, script/offer confusion, etc.) — distinct from technical issues
  // so Ethan can see which bucket today's friction is actually in.
  organizationalIssues  String?  @db.Text

  // Free-form positives + forward-looking notes.
  wins                  String?  @db.Text
  tomorrowFocus         String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One report per agent per shift day. Agents can PATCH to edit it.
  @@unique([agentUserId, reportDate])
  @@index([reportDate])
}

// -----------------------------------------------------------------------------
// Callbacks — agent's personal follow-up list. Distinct from Appointment:
// a callback is a prospect to *call again later*, not a confirmed booking.
// Tracked per-agent; no staff rollup in v1 (this is the agent's own notebook,
// not a KPI for management). If a callback converts to an appointment, the
// agent books it normally and marks the callback done.
// -----------------------------------------------------------------------------

model Callback {
  id            String    @id @default(cuid())
  agentUserId   String
  agent         User      @relation("AgentCallbacks", fields: [agentUserId], references: [id], onDelete: Cascade)

  customerName  String
  customerPhone String
  // When the agent plans to call back (date + time).
  callbackAt    DateTime
  notes         String?   @db.Text

  // Set when the agent marks the callback as handled. Null = still pending.
  completedAt   DateTime?
  // Optional short outcome label when completing: "booked" | "not_interested"
  // | "no_answer" | "rescheduled" | "other". Kept as a free string for now so
  // we can refine the options after a week of real usage.
  outcome       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentUserId, callbackAt])
  @@index([agentUserId, completedAt])
}
