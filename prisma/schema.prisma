// Genisys Hub — Prisma schema (Postgres)
//
// Run `npm run prisma:migrate` to apply schema changes locally.
// Run `npm run prisma:deploy` in production (Render) to run pending migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7, url lives in prisma.config.ts. The Prisma client uses the
  // @prisma/adapter-pg driver adapter (see src/lib/prisma.ts).
}

// -----------------------------------------------------------------------------
// Auth.js (NextAuth v5) standard tables
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  // Roles:
  //   member             — staff, default for Google SSO signups
  //   admin              — staff with admin privileges (first user, or promoted)
  //   agent_pending      — registered but awaiting approval (no access yet)
  //   agent              — approved call-center agent, can access /agent only
  //   agent_denied       — registration denied
  //   client_pending     — self-registered client, awaiting onboarding form
  //   client_onboarding  — onboarding form submitted, awaiting admin approval
  //   client_active      — approved client, can access /client only
  //   client_denied      — application denied
  //   team_pending       — Team #N registrant awaiting approval (no access yet)
  //   team_member        — approved Team #N agent, EOD-only access at /team
  //   team_denied        — Team #N registration denied
  role          String    @default("member")
  // For Credentials-auth users (agents + clients). Null for Google SSO users.
  passwordHash  String?
  // Forces a password change on next sign-in. Set true when admin
  // generates a temporary password for a client; cleared when the
  // user picks their own.
  mustChangePassword Boolean @default(false)
  // Forgot-password flow. tokenHash is bcrypt'd; the raw token only
  // ever exists in the email link. Cleared on successful reset OR
  // after expiry.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  // Which Client this user belongs to — populated for client_* roles
  // only. Drives the per-client master-tracker filter on /client.
  // CASCADE on delete: when admin deletes a Client, every linked
  // login row gets removed too. Previously SetNull, which left
  // orphaned-active users wedged on /client with no recovery path.
  clientId      String?
  client        Client?   @relation("ClientUsers", fields: [clientId], references: [id], onDelete: Cascade)
  // Which tab title was created in the master appointments spreadsheet for
  // this agent (set when their registration is approved). Null otherwise.
  agentSheetTab String?
  // When the agent was approved. Null for pending / denied / staff.
  approvedAt    DateTime?
  approvedById  String?
  timezone      String    @default("America/New_York")
  phoneNumber   String?   // E.164, used for SMS reminders
  // Team-member fields — set on team_pending registration, carried
  // through approval. Null for everyone else (staff, regular agents,
  // clients).
  //   servicingState  — US state the team agent is calling for.
  //                     Editable from /team/profile after approval.
  //   whatsappNumber  — preferred contact line, free-text (admin reaches
  //                     out via WhatsApp). Editable from /team/profile.
  //   teamNumber      — which team this user belongs to. 1 = Mary's
  //                     team. Reserved for future Team #2+. Lookup of
  //                     "who manages each team" lives in the
  //                     TEAM_MANAGER_EMAILS env var (JSON map), not
  //                     the DB, so it can be updated without a code
  //                     change when management shifts.
  servicingState String?
  whatsappNumber String?
  teamNumber     Int?

  /// Call-center extension assigned by admin after approval. Becomes
  /// the username for Team #1 sign-in (email is no longer used as
  /// the login key for that flow). Unique when set; null for users
  /// who don't sign in via the call-center-number path (regular
  /// agents, admin/member, client users). Partial unique index keeps
  /// the constraint cheap.
  callCenterNumber String? @unique
  /// 6-character lookup code shown to a Team #1 user on the
  /// "registration received" screen so they can identify their
  /// pending account to their supervisor out-of-band ("here's my
  /// code, please approve me"). Generated at registration time;
  /// cleared by the approval flow once the call-center number is
  /// assigned so the row doesn't need to retain it. Null for
  /// non-Team #1 users.
  registrationLookupCode String?

  /// Team number this user is the day-to-day manager for. Set on
  /// Mary's user row (=1) so she can approve Team #1 registrations
  /// + assign initial call-center numbers without admin acting as
  /// a bottleneck. Null = not a manager. Admin still owns the
  /// destructive paths (reset password, change number on an active
  /// user, delete) — managers only get approve/deny + initial
  /// assignment. Toggle from /agents.
  managesTeamNumber      Int?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  calendarConnections CalendarConnection[]
  tasks               Task[]
  scheduledSms        ScheduledSms[]
  vaultCreated        VaultEntry[]        @relation("VaultEntryCreator")
  vaultAccessLogs     VaultAccessLog[]
  appointments        Appointment[]       @relation("AgentAppointments")
  eodReports          EodReport[]         @relation("AgentEodReports")
  callbacks           Callback[]          @relation("AgentCallbacks")
  documentsUploaded   Document[]          @relation("DocumentUploader")
  documentFoldersCreated DocumentFolder[] @relation("DocumentFolderCreator")
  followUpDismissals  FollowUpDismissal[] @relation("FollowUpDismissals")
  appointmentEdits    AppointmentEditLog[] @relation("AppointmentEditor")
  /// Appointments this admin/member has marked as reviewed on the
  /// /call-center/status-updates triage page. Lets the page show
  /// "Reviewed by Ethan" badges and audit who triaged what. SetNull
  /// on the Appointment side so deleting a user doesn't block the
  /// row.
  statusUpdateReviews Appointment[]       @relation("AppointmentReviewer")

  /// Chat messages this user has sent in the internal Team #1
  /// group chat. SetNull on user delete — the message row keeps
  /// its denormalized senderName/senderImage snapshot so chat
  /// history stays readable after a user leaves.
  chatMessages        ChatMessage[]       @relation("ChatMessageSender")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Email / inbox (ported from Pf Hub, trimmed for Genisys)
// -----------------------------------------------------------------------------

model GmailAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  tokenExpiry  DateTime
  historyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emails Email[]
}

model Email {
  id             String       @id @default(cuid())
  gmailMessageId String       @unique
  threadId       String?
  accountId      String
  account        GmailAccount @relation(fields: [accountId], references: [id])
  from           String
  fromName       String?
  to             String
  subject        String
  bodyText       String?      @db.Text
  bodyHtml       String?      @db.Text
  snippet        String?
  date           DateTime
  folder         String       @default("inbox")
  isRead         Boolean      @default(false)
  isLead         Boolean      @default(false)
  leadConfidence Float?
  category       String?
  classifiedAt   DateTime?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  drafts         DraftReply[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accountId, date])
  @@index([isLead])
  @@index([folder])
}

model DraftReply {
  id            String    @id @default(cuid())
  emailId       String
  email         Email     @relation(fields: [emailId], references: [id])
  body          String    @db.Text
  status        String    @default("draft") // draft | approved | sent
  autoGenerated Boolean   @default(false)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model Lead {
  id           String    @id @default(cuid())
  name         String?
  email        String?   @unique
  phone        String?
  company      String?
  serviceType  String? // "roofing" | "solar" | other
  zip          String?
  status       String    @default("new") // new | contacted | booked | closed_won | closed_lost
  source       String    @default("email") // email | ad | cold_call | referral
  ghlContactId String?
  ghlSubId     String? // which GHL sub-account owns this lead
  notes        String?   @db.Text
  emails       Email[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// Google Drive — per-mailbox connections (alex@, ethan@leadgenisys.com)
// -----------------------------------------------------------------------------

model DriveAccount {
  id             String    @id @default(cuid())
  email          String    @unique
  accessToken    String    @db.Text
  refreshToken   String    @db.Text
  tokenExpiry    DateTime
  // Reserved for future incremental sync via Drive Changes API.
  startPageToken String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// GoHighLevel — 4 sub-accounts
// -----------------------------------------------------------------------------

model GhlSubAccount {
  id          String   @id @default(cuid())
  name        String // "Genisys", "Client — Acme Roofing", etc.
  locationId  String   @unique // GHL locationId
  tokenVaultId String? // points at a VaultEntry that holds the Private Integration token
  isOwnAgency Boolean  @default(false) // true for the Genisys sub, false for clients
  color       String   @default("#3b82f6") // for sidebar grouping
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Calendar connections — Google Workspace (leadgenisys.com) + Trustware for Ethan
// -----------------------------------------------------------------------------

model CalendarConnection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "google" | "ical" (fallback if OAuth blocked)
  label        String // "Genisys Workspace", "Trustware", etc.
  email        String? // Google account email for this connection
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  tokenExpiry  DateTime?
  icalUrl      String?  @db.Text // used when provider = "ical"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Today page — tasks + scheduled SMS briefs
// -----------------------------------------------------------------------------

model Task {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  notes      String?   @db.Text
  dueAt      DateTime?
  completedAt DateTime?
  priority   String    @default("normal") // low | normal | high
  notionPageId String? // if synced to a Notion page
  ghlOpportunityId String? // if synced to a GHL opportunity
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, dueAt])
  @@index([userId, completedAt])
}

model ScheduledSms {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  timeOfDay String // "07:00" in the user's timezone
  // Delivery channel:
  //   slack    — DM via Slack (default, needs the user to be in the workspace)
  //   ghl_sms  — SMS via the GHL Private Integration token (needs recipientPhone)
  channel   String   @default("slack")
  // Destination phone when channel=ghl_sms. Falls back to User.phoneNumber.
  recipientPhone  String?
  // Optional Notion assignee to filter the task board by (e.g. "Ethan"). When
  // set, the brief's task section is drawn from the pinned Notion Kanban's
  // "To Do"-ish column, restricted to tasks assigned to this name, instead of
  // the user's local Task rows.
  notionAssignee  String?
  // Timezone for the schedule (IANA). When set, overrides the schedule
  // owner's User.timezone so the brief fires at the recipient's local time,
  // not the admin's. Crucial when the admin and recipient are in different
  // time zones (e.g., Alex in ET scheduling a brief for Ethan in PT).
  timezone        String?
  includeTasks    Boolean @default(true)
  includeMeetings Boolean @default(true)
  lastSentAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Vault — encrypted API keys, shared across the team
// -----------------------------------------------------------------------------

model VaultEntry {
  id            String   @id @default(cuid())
  name          String // "GHL • Genisys", "Anthropic", etc.
  description   String?  @db.Text
  ciphertext    Bytes // encrypted secret value
  nonce         Bytes // 24-byte nonce for XChaCha20-Poly1305
  tags          String[] // for grouping in UI
  createdById   String
  createdBy     User     @relation("VaultEntryCreator", fields: [createdById], references: [id])
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accessLogs VaultAccessLog[]

  @@index([name])
}

model VaultAccessLog {
  id        String      @id @default(cuid())
  entryId   String
  entry     VaultEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    String // "view" | "edit" | "delete" | "create"
  createdAt DateTime    @default(now())

  @@index([entryId, createdAt])
  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Slack — stubs, wired later
// -----------------------------------------------------------------------------

model SlackWorkspace {
  id         String   @id @default(cuid())
  teamId     String   @unique
  teamName   String
  accessToken String  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  channels SlackChannel[]
}

model SlackChannel {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       SlackWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId       String
  channelName     String
  isMonitored     Boolean       @default(false) // only pull messages for channels the user cares about
  lastMessageTs   String?
  clientName      String? // optional label: "Acme Roofing" etc.

  messages SlackMessage[]

  @@unique([workspaceId, channelId])
}

model SlackMessage {
  id          String       @id @default(cuid())
  channelId   String
  channel     SlackChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slackTs     String // Slack's message timestamp, unique per channel
  userSlackId String
  userName    String?
  text        String       @db.Text
  threadTs    String? // for threaded replies
  isOurReply  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@unique([channelId, slackTs])
  @@index([channelId, createdAt])
}

// -----------------------------------------------------------------------------
// Misc
// -----------------------------------------------------------------------------

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

// -----------------------------------------------------------------------------
// Documents — simple internal file storage for contracts, signed agreements,
// and other important documents shared between staff. Files stored directly
// in Postgres (bytea) so there's no extra infra / object store to manage.
// Separate from the Google Drive module (that reads your personal Drive; this
// is a self-contained Hub store). Staff-only access.
// -----------------------------------------------------------------------------

model DocumentFolder {
  id          String           @id @default(cuid())
  name        String
  // Null parentId = root-level folder. Cascade so deleting a parent
  // removes its child folders (and by extension the documents inside).
  parentId    String?
  parent      DocumentFolder?  @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DocumentFolder[] @relation("DocumentFolderTree")
  documents   Document[]
  createdById String
  createdBy   User             @relation("DocumentFolderCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([parentId])
}

model Document {
  id           String          @id @default(cuid())
  // Null folderId = root (no folder). Cascade so deleting a folder takes
  // its documents with it.
  folderId     String?
  folder       DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  sizeBytes    Int
  content      Bytes           // raw file bytes
  uploadedById String
  uploadedBy   User            @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([folderId])
}

// -----------------------------------------------------------------------------
// Call-center appointments — booked by agents via /agent portal.
// One row per appointment; synced to the master spreadsheet (one row in the
// agent's personal tab + one row in the master rollup tab).
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// Clients — the Genisys agency books appointments on behalf of multiple
// solar companies. Each appointment must identify which client it belongs to
// so we can split reporting + sheet sync correctly. Seeded at migration time
// (Brighton Capital Solar, Spring Solar); new clients added via SQL/Prisma
// Studio for now — no admin UI yet.
// -----------------------------------------------------------------------------

model Client {
  id           String   @id @default(cuid())
  name         String   @unique
  state        String? // e.g. "Arizona", "Utah" — for agent context only
  color        String   @default("#3b82f6") // hex for badges
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ---- Relationship + contact details ------------------------------------
  // Free-form text so admins can paste whatever the client cares about
  // without a schema migration each time. All optional — the create
  // flow stays fast for cases where these aren't known yet.
  contactName     String? // primary human contact ("David Mehta")
  contactRole     String? // their role ("VP Revenue", "COO")
  contactEmail    String?
  contactPhone    String? // stored canonical-formatted ("(555) 123-4567")
  address         String?
  notes           String? // long-form, multi-line — markdown-ish OK
  intakeFormUrl   String?
  ghlSubaccountUrl String?

  // Free-text list of zipcodes the client services / wants leads from.
  // Captured during the self-onboarding form. Stored as a comma- or
  // whitespace-separated string for now — JSON later if we ever need
  // to query / index ranges. Optional because admin-created clients
  // don't always have a fixed service area.
  servicingZipcodes String?

  // Intake answers captured during the self-onboarding form (added
  // 2026-05-11). All nullable so existing clients aren't broken; the
  // form requires the booleans + appointmentTypes on submission so
  // new clients always have values. Admin can edit any of these
  // later via the client edit dialog.
  //
  //   appointmentTypes — preferred meeting format. One of:
  //     "in_person" | "virtual" | "both"
  //     Used by Mary when qualifying leads — a virtual-only client
  //     shouldn't get drive-out appointments.
  //
  //   bookWeekends — whether the client accepts Saturday/Sunday
  //     appointments. Constrains the booking calendar Mary works
  //     against.
  //
  //   website — optional URL the client shared during onboarding.
  //     Surfaced in the admin Additional info panel as a clickable
  //     link so the team can verify the business at a glance.
  //
  //   providesBatteryBackup — whether the client installs battery
  //     backup systems alongside solar. Affects which leads qualify
  //     (some homeowners specifically want battery; if the client
  //     doesn't install them, the lead is a mismatch).
  appointmentTypes      String?
  bookWeekends          Boolean?
  website               String?
  providesBatteryBackup Boolean?

  // Free-form intake answers from the self-onboarding form (added
  // 2026-05-11). Both optional + long-form (@db.Text) so prospects
  // can type as much or as little as they want.
  //
  //   qualificationCriteria — the client's own description of what
  //     makes a good lead for them (e.g. "homeowner, 680+ credit,
  //     $150+/mo bill, no shading"). Pairs with Mary's own client
  //     reference sheet — eventually we want the answer here to
  //     replace the manual sheet entirely.
  //
  //   onboardingNotes — catch-all "anything else admin should know"
  //     from the client at signup time. Distinct from `notes` above,
  //     which is ADMIN's internal notes ABOUT the client.
  qualificationCriteria String? @db.Text
  onboardingNotes       String? @db.Text

  // Lifecycle status — richer than the boolean `active`. Valid values:
  //   "pending"      — self-registered + onboarding form submitted,
  //                    awaiting admin approval (Phase 2 client-access)
  //   "active"       — engaged + booking
  //   "onboarding"   — in setup, not yet receiving bookings
  //   "paused"       — temporarily on hold
  //   "churned"      — relationship ended (kept for historical reporting)
  //   "denied"       — self-registration was rejected
  // The legacy `active` flag still gates list visibility for now so
  // agents don't see churned clients in their booking picker.
  lifecycle       String   @default("active")

  // ---- Package / delivery commitment -------------------------------------
  // Which contract tier the client is on. Drives the default appt
  // cap (Growth → 20, Pro → 30) and lets the Clients page show a
  // "12/20 delivered" progress bar. PPA = pay-per-appt, no nominal
  // cap. "custom" = bespoke deal where the cap (or absence of one)
  // is set manually via apptCap.
  // Valid values: "ppa" | "growth" | "pro" | "custom"
  package         String   @default("custom")

  // Nominal appointment cap for the package — null means unlimited
  // (sit-down-guarantee deal where we keep delivering past any
  // nominal cap until the sit-down count is hit). The Clients page
  // treats this as a target, not a hard stop — over-cap rows still
  // count and surface in green. PPA now defaults to 10 (was null
  // historically); existing rows are not backfilled by the migration.
  apptCap         Int?

  // Manual override for the cap-fulfillment due date. When null, the
  // Clients page shows a computed default per package:
  //   PPA     → 14 days from createdAt (within 2 weeks)
  //   Growth  → 21 days (within 3 weeks)
  //   Pro     → 28 days (within 4 weeks)
  //   Custom  → no default (admin sets manually)
  // Set via the date picker in the edit form when the contract
  // turnaround diverges from the package default.
  dueDate         DateTime?

  // Slack channel for this client. Auto-provisioned on approval
  // by lib/client-workspace.ts: a private "client-{slug}" channel
  // gets created, the team is invited as members, and the
  // contactEmail gets a Slack Connect invite. The same channel
  // doubles as the new-appointment / message-alert delivery target
  // (was previously set manually via Settings → Client delivery).
  // null = not yet provisioned (or pre-feature legacy client).
  // slackChannelName is a cached label so the UI doesn't need to
  // round-trip Slack on every render.
  slackChannelId    String?
  slackChannelName  String?
  // When the Slack Connect email invite was sent to contactEmail.
  // null = either contactEmail was missing, the inviteShared call
  // failed, or this is a legacy pre-feature client. Lets us show
  // a "resend invite" affordance if the client never accepted.
  slackInviteSentAt DateTime?

  // Per-client opt-in for the Email Client Alerts surface (Spring
  // Solar asked for email parity with the existing SMS + Slack alerts,
  // 2026-05-20). Defaults to false so first-deploy doesn't blast
  // every contactEmail on the roster. Email goes to contactEmail
  // verbatim — leaving that field null silently disables alerts even
  // when this flag is true. Master enable lives on
  // ClientEmailAlertsConfig (singleton).
  emailAlertsEnabled Boolean @default(false)

  /// Official start date of services for the client. Set when the
  /// client COMPLETES the onboarding form (lifecycle flip to active)
  /// after admin approves them in /clients/onboarding. Drives the
  /// bi-weekly PPA invoice cadence (first invoice fires
  /// serviceStartDate + 14 days). Null for legacy clients who became
  /// active before this field existed.
  serviceStartDate    DateTime?

  /// PPA invoicing cutoff. Status updates with clientStatusUpdatedAt
  /// at or before this timestamp are excluded from the invoice
  /// calculation — used to draw a clean line at deploy time so
  /// already-invoiced cycles don't get re-billed by the new
  /// automation. Null = no cutoff (count everything since
  /// serviceStartDate). Backfilled to deploy-time for all existing
  /// PPA clients.
  invoicingCutoffAt   DateTime?

  /// Timestamp of the last invoice that fired for this client.
  /// Drives next-invoice math (next = lastInvoicedAt + 14 days);
  /// also gates the "is this client due to be invoiced again" check
  /// in the daily scheduler tick. Null until the first invoice ever
  /// goes out — that first one is computed from serviceStartDate
  /// instead.
  lastInvoicedAt      DateTime?

  appointments      Appointment[]
  reminderTemplates ReminderTemplate[]
  appointmentReminders AppointmentReminder[]
  slackDeliveries   SheetSlackDelivery[]
  clientAlerts      ClientAlertDelivery[]
  emailAlerts       ClientEmailDelivery[]
  messageAlerts     ClientMessageAlert[]
  // Secondary Google Sheets that feed this client's appointments
  // (partner call centers like Yassin's team running their own
  // sheets — see model SecondarySheet at the bottom of the file).
  secondarySheets   SecondarySheet[]
  appointmentEdits  AppointmentEditLog[] @relation("ClientAppointmentEdits")
  // User accounts that can log in to /client and see only this
  // client's appointments. Created by admin via the Credentials tab,
  // or self-registered through the onboarding flow (Phase 2+).
  users             User[]                @relation("ClientUsers")
  invoices          Invoice[]
}

/// PPA invoice records — one row per bi-weekly invoice the
/// automation generates for a PPA client. Stores enough audit info
/// (which appointments, which payment link, which delivery results)
/// to reconstruct exactly what got billed even if the underlying
/// appointments are later edited or deleted.
///
/// Created by lib/ppa-invoicing.ts as part of the daily scheduler
/// tick. Overflow case (>4 qualified appts in one cycle) creates a
/// row with deliveryError set to 'overflow' so admin can see in the
/// audit which cycles required manual delivery.
model Invoice {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Inclusive start of the bi-weekly cycle this invoice covers.
  /// Set to whichever's later — the previous lastInvoicedAt or the
  /// client's serviceStartDate — so the first-ever invoice has a
  /// clean cycle anchor.
  cycleStartAt    DateTime
  /// Inclusive end of the cycle (typically the moment the invoice
  /// fires). Lets reports group invoices into cycles without
  /// fence-post bugs.
  cycleEndAt      DateTime

  appointmentCount Int
  /// JSON array of appointment ids this invoice covered. Snapshot
  /// at fire-time so it survives appointment edits/deletes.
  appointmentIds   Json

  /// Total in cents. 1 appt × $275 = 27500. Stored in cents so
  /// money math stays integer.
  amountCents     Int
  /// QuickBooks payment link the client receives. Sourced from
  /// lib/ppa-invoicing-config.ts; for the overflow case this is
  /// empty string (no auto-delivery, admin handles manually).
  paymentLink     String

  /// Set when the email send actually succeeds. Null when delivery
  /// failed or wasn't attempted (e.g. overflow case).
  emailSentAt     DateTime?
  smsSentAt       DateTime?
  /// Non-null when something went wrong. 'overflow' = >4 qualified
  /// appts, requires manual invoice; otherwise the literal Gmail /
  /// GHL error message. Surfaced in the Slack alert + future admin
  /// invoices UI.
  deliveryError   String?

  createdAt       DateTime @default(now())

  @@index([clientId, cycleEndAt])
}

model Appointment {
  id              String   @id @default(cuid())
  agentUserId     String
  agent           User     @relation("AgentAppointments", fields: [agentUserId], references: [id], onDelete: Cascade)

  // Which client the appointment is booked for. Nullable so historical
  // rows (pre-Client-feature) don't need backfill; required enforced in
  // the POST /api/agent/appointments handler for new bookings.
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Booking details — matches the fields the call center currently records.
  apptDateTime    DateTime
  customerName    String
  customerPhone   String
  address         String?
  email           String?
  monthlyBill     String?
  utilityProvider String?
  roofType        String?
  roofAge         String?
  status          String   @default("booked") // booked | rescheduled | showed | no_show | cancelled | won | lost
  estimatedDealValue String?
  notes           String?  @db.Text
  callRecordingLink String?

  /// Notes the agency CLIENT (not the homeowner) wrote when they
  /// updated the appointment status from their /client dashboard.
  /// Distinct from `notes` (Mary's notes) so admin can see both
  /// perspectives without one overwriting the other. Long-form;
  /// added 2026-05-29 alongside the client-side "did they show?"
  /// status update flow.
  clientNotes     String?  @db.Text
  /// Last time the client toggled the status field from their
  /// dashboard. Null when the client has never touched it (Mary
  /// owns all transitions until the client engages). Surfaced in
  /// the master tracker so admin can tell "Mary said showed two
  /// days ago" vs "Client just confirmed no-show 5 minutes ago"
  /// at a glance.
  clientStatusUpdatedAt DateTime?

  /// Timestamp of the most recent BILLABLE status update — i.e. an
  /// update to {showed, won, lost} made by an admin, member, OR
  /// the client themselves. Mary (role=agent) cannot stamp this
  /// field; her marks are advisory only and never trigger an
  /// invoice. Drives the PPA bi-weekly invoicing automation.
  ///
  /// Distinct from clientStatusUpdatedAt (which is set only by the
  /// client's /client dashboard updates and drives the Status
  /// Updates triage page).
  qualifyingStatusUpdatedAt DateTime?

  /// Whether the client marked this prospect as disqualified
  /// during the update flow. Captured ONLY when they answered
  /// "showed" — the question doesn't render for no-show. Null = no
  /// answer yet (the field's been added since this appointment was
  /// last updated, or the client only ever picked no-show). True =
  /// they sat down but the prospect washed (bad credit, renter, no
  /// home ownership, can't afford, etc.). False = qualified, real
  /// pipeline.
  customerDisqualified     Boolean?
  /// When an admin/member triaged a client-side status update on
  /// /call-center/status-updates. Null = unreviewed (drives the
  /// red-dot badge on the tab + the "Awaiting client review"
  /// section). Distinct from clientStatusUpdatedAt so subsequent
  /// client edits re-surface the row as unreviewed even after a
  /// previous admin review.
  clientStatusReviewedAt   DateTime?
  /// Hub user who marked the latest review. SetNull on User
  /// delete so the column doesn't block deletion. Null when
  /// clientStatusReviewedAt is null.
  clientStatusReviewedById String?
  clientStatusReviewedBy   User? @relation("AppointmentReviewer", fields: [clientStatusReviewedById], references: [id], onDelete: SetNull)

  // Free-text "booked by" — the human agent who took the call.
  // Distinct from agentUserId, which is the Hub user that submitted
  // the row (Mary, the only Hub-user agent now). When null, displays
  // and sheet sync fall back to that user's own name.
  bookedByName    String?

  // Snapshot of the Google Solar API summary at booking time. JSON
  // shape matches lib/solar.ts SolarSummary (viability + sunshine
  // hours + max/recommended panels + production + roof area). Only
  // populated when SolarInsightsCache has a row for the address at
  // create/edit time — guarantees zero extra billable API calls
  // from the appointment create handler.
  solarSummary    Json?

  // Google Sheets sync tracking — row numbers in the agent's tab and the
  // master rollup tab. Null until first sync succeeds; populated after so
  // subsequent edits update the existing rows instead of duplicating.
  agentSheetRowNumber  Int?
  masterSheetRowNumber Int?
  lastSyncedAt         DateTime?
  syncError            String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders AppointmentReminder[]
  editLogs  AppointmentEditLog[]

  @@index([agentUserId, createdAt])
  @@index([status])
  @@index([apptDateTime])
  @@index([clientId])
}

// -----------------------------------------------------------------------------
// SMS appointment reminders. The Hub sends per-appointment SMS reminders to
// customers via the GHL API (1 day before, 2 hr before, 30 min before, and
// at appointment start). One row per (appointment, reminder type) — synced
// from the master spreadsheet on every scheduler tick so manual sheet
// entries get reminders too, not just Hub-booked rows.
//
// Past appointments are guarded — reminders whose `scheduledFor` is already
// in the past at insert time get marked `skipped` immediately so the
// dispatcher never accidentally fires "your appointment is starting" two
// weeks late.
// -----------------------------------------------------------------------------

model AppointmentReminder {
  id              String   @id @default(cuid())

  // Source of truth — exactly one of these resolves to the appointment:
  //   1. appointmentId for Hub-booked rows (preferred when available)
  //   2. sheetTabTitle + sheetRowNumber for sheet-only rows
  // Both are persisted when known so a sheet-row that later picks up
  // a DB ID stays linkable.
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sheetTabTitle   String?
  sheetRowNumber  Int?

  // Composite source key — "db:cuid" or "sheet:Master Table:42" — used
  // for the unique index alongside reminderType. Stable per appointment
  // so re-syncs upsert instead of duplicating.
  sourceKey       String

  // Which window this reminder is for. One of: "1day" | "2hr" | "30min"
  // | "start". Strings instead of an enum so adding new windows later
  // is just a config change.
  reminderType    String

  // UTC moment the reminder should fire. Computed at row-create time
  // from apptDateTime + customerTimezone, then never recomputed —
  // edits to the source row trigger a re-sync that produces a fresh
  // reminder row (the old one gets cancelled).
  scheduledFor    DateTime

  // Snapshots so we can render the SMS even if the source row is
  // edited / deleted between sync and dispatch. Keeps the message
  // body stable + audit trail honest.
  customerName    String
  customerPhone   String
  customerTimezone String
  apptDateTime    DateTime
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName      String?  // business name (Client.name)
  clientContactName String? // primary human contact (Client.contactName)
  address         String?
  agentName       String?

  // Send tracking. Lifecycle: pending → sending → sent | failed.
  // Skipped = past-due at create time (we never even tried). Cancelled
  // = the source row went away or got marked cancelled before fire.
  status          String   @default("pending")
  sentAt          DateTime?
  errorMessage    String?  @db.Text
  ghlContactId    String?
  ghlMessageId    String?
  ghlConversationId String?

  // Final rendered body — captured at send time so the SMS log shows
  // exactly what the customer received, even if a template is later
  // edited.
  messageBody     String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceKey, reminderType], map: "ux_reminder_source_type")
  @@index([scheduledFor, status])
  @@index([appointmentId])
  @@index([clientId])
  @@index([status, sentAt])
}

// Per-(client, reminderType) message body. Falls back to the
// hardcoded defaults in lib/reminders.ts when no template is set —
// so the system works out of the box and admins only edit what they
// want to override. clientId=null is the global default override
// (rarely used in practice, but lets us flip default copy without
// touching code).
model ReminderTemplate {
  id           String   @id @default(cuid())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reminderType String

  body         String   @db.Text
  enabled      Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, reminderType], map: "ux_template_client_type")
}

// Cache layer for Google Solar API (Project Sunroof productized).
// One row per normalized address ever queried. Cache hits don't
// re-bill the upstream API; misses do, and the row is created so
// future calls are free. Solar imagery updates yearly at most, so
// rows are effectively immortal — clear them manually if Google
// ships better imagery and you want a fresh fetch.
model SolarInsightsCache {
  id             String   @id @default(cuid())
  addressKey     String   @unique(map: "ux_solar_insights_address_key")
  rawAddress     String
  latitude       Float?
  longitude      Float?
  imageryQuality String?  // HIGH | MEDIUM | LOW (per Google)
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

// Idempotency ledger for client-channel Slack deliveries. One row per
// (sourceKey, channelId) — the channelId is part of the key so a
// channel reroute starts a fresh delivery history rather than
// silently swallowing future posts.
//
// status:
//   delivered  — successfully posted to Slack; messageTs is set
//   backfilled — pre-existing sheet row at the time the channel was
//                first configured. Never posted; recorded so the sync
//                doesn't blast historical rows on first deploy.
//   failed     — last attempt failed; errorMessage holds the cause
model SheetSlackDelivery {
  id           String   @id @default(cuid())
  sourceKey    String   // matches AppointmentReminder.sourceKey shape
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  channelId    String
  status       String   @default("delivered")
  messageTs    String?
  /** Slack permalink to the delivered message — set immediately
   *  after posting via chat.getPermalink. Used as both a
   *  verification gate (if the lookup fails the post is treated
   *  as silent-fail and the row goes to status='failed') and as
   *  a click-through affordance in the Master Tracker UI. */
  permalink    String?
  errorMessage String?  @db.Text
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Content-based dedup. The sourceKey index (below) catches the
  // common case, but a sheet rowNumber shift (Mary inserting a row
  // above an existing one) generates a fresh sourceKey for the
  // shifted rows and the unique constraint silently allows a re-
  // post. Customer phone + appointment time stay stable across
  // shuffles, so the sync also checks this pair before inserting.
  customerPhone String?
  apptDateTime  DateTime?

  @@unique([sourceKey, channelId], map: "ux_sheet_slack_delivery_source_channel")
  @@index([clientId])
  @@index([status])
  @@index([channelId, customerPhone, apptDateTime], map: "SheetSlackDelivery_content_dedup_idx")
}

/// "Client Alerts" feature — SMS notifications to a client's
/// contactPhone whenever a new appointment lands in the master
/// sheet for them. Mirrors the Slack-channel delivery flow but
/// over GHL SMS, with its own ledger so failures on one channel
/// don't suppress the other. Default off — admin opts in via
/// Settings, which triggers a backfill so first-enable doesn't
/// blast historical bookings.
model ClientAlertsConfig {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  vaultEntryName  String   @default("GHL Genisys Token")
  /// Optional E.164 sender override (e.g. "+16038034828"). Null
  /// falls back to the GHL location's default phone.
  senderPhone     String?
  updatedAt       DateTime @updatedAt @default(now())
}

/// Idempotency ledger for Client Alert SMS — parallel to
/// SheetSlackDelivery. Same dual-key dedup story (sourceKey +
/// content key with a recency window applied in sync code), kept
/// in a separate table so SMS history doesn't tangle with Slack
/// history on retry. recipientPhone is stored verbatim so a later
/// contactPhone change on the Client doesn't hide what actually
/// went out.
model ClientAlertDelivery {
  id              String   @id @default(cuid())
  sourceKey       String
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recipientPhone  String
  // status:
  //   pending    — DB-driven path queued the alert with a buffer
  //                window; dispatch fires it once scheduledFor passes.
  //                Each subsequent edit by the agent rolls scheduledFor
  //                forward (so the alert reflects the final state).
  //   delivered  — GHL acknowledged the SMS
  //   backfilled — pre-existing sheet row at the time the master toggle
  //                flipped on; never sent
  //   failed     — GHL returned an error; errorMessage carries detail
  status          String   @default("delivered")
  /// Set when status='pending' to indicate when the buffer window
  /// expires and the dispatcher should send. Null for non-pending
  /// rows (delivered / backfilled / failed). Indexed so the
  /// dispatcher's "due" query is cheap.
  scheduledFor    DateTime?
  messageId       String?
  conversationId  String?
  errorMessage    String?  @db.Text
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Content-based dedup pair (parallel to SheetSlackDelivery).
  customerPhone   String?
  apptDateTime    DateTime?

  @@unique([sourceKey, recipientPhone], map: "ux_client_alert_delivery_source_recipient")
  @@index([clientId])
  @@index([status])
  @@index([status, scheduledFor], map: "ClientAlertDelivery_pending_due_idx")
  @@index([recipientPhone, customerPhone, apptDateTime], map: "ClientAlertDelivery_content_dedup_idx")
}

/// "Email Client Alerts" feature — admin-managed parity layer over the
/// existing SMS + Slack alert channels. Each Client opts in via
/// Client.emailAlertsEnabled; the master toggle here gates the whole
/// surface in case admin wants to kill the channel in an emergency.
/// id is hardcoded to "singleton" so it's always upsertable.
model ClientEmailAlertsConfig {
  id               String   @id @default("singleton")
  enabled          Boolean  @default(false)
  /// Which connected Gmail account to send from. Defaults to the
  /// agency's primary inbox; staff can pick a different connected
  /// account via Settings if they want alerts to come from a shared
  /// "alerts@" mailbox. Looked up against GmailAccount.email at send
  /// time; null falls back to whatever the env var
  /// CLIENT_EMAIL_ALERT_FROM resolves to (then to alex@leadgenisys.com).
  fromGmailAccount String?
  /// Display name on the From: header (e.g. "Genisys Hub Alerts").
  /// Falls back to "Genisys Hub" when null.
  senderName       String?
  updatedAt        DateTime @updatedAt @default(now())
}

/// Idempotency ledger for Email Client Alerts — parallel to
/// ClientAlertDelivery (SMS) + SheetSlackDelivery (Slack). Same
/// dual-key dedup pattern (sourceKey + content key with recency
/// window applied in sync code). recipientEmail is stored verbatim
/// so a later contactEmail change on the Client doesn't hide what
/// actually went out.
model ClientEmailDelivery {
  id              String    @id @default(cuid())
  sourceKey       String
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recipientEmail  String
  // status mirror of ClientAlertDelivery:
  //   pending    — DB-driven queue waiting on the 20-min buffer
  //   sending    — claim flipped pending → sending before send fires
  //   delivered  — Gmail returned a messageId
  //   backfilled — pre-existing sheet row at first-enable; never sent
  //   failed     — send threw; errorMessage carries detail
  //   skipped    — appointment cancelled / deleted before send fired
  status          String    @default("delivered")
  /// Set when status='pending' to indicate when the buffer window
  /// expires and the dispatcher should send.
  scheduledFor    DateTime?
  /// Gmail-side message id. Populated on successful delivery so we
  /// can cross-reference with the sender's Gmail Sent folder.
  messageId       String?
  errorMessage    String?   @db.Text
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Content-based dedup pair (parallel to the SMS / Slack ledgers).
  customerPhone   String?
  apptDateTime    DateTime?

  @@unique([sourceKey, recipientEmail], map: "ux_client_email_delivery_source_recipient")
  @@index([clientId])
  @@index([status])
  @@index([status, scheduledFor], map: "ClientEmailDelivery_pending_due_idx")
  @@index([recipientEmail, customerPhone, apptDateTime], map: "ClientEmailDelivery_content_dedup_idx")
}

// Singleton config for the SMS-reminder system. Master enable + which
// vault entry's GHL JWT token to use for sending. id is hardcoded to
// "singleton" so it's always upsertable with a known key.
model RemindersConfig {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  vaultEntryName  String   @default("GHL Genisys Token")
  // Cap how far ahead we'll create reminder rows. Anything further
  // out gets re-evaluated on the next sync. Default 10 days covers
  // the 1-day-out window with margin to spare.
  lookaheadDays   Int      @default(10)
  // TCPA compliance — don't send SMS outside these hours (in the
  // *customer's* local timezone, derived from address state).
  // 24-hour format "HH:mm". Defaults align with the TCPA window
  // (8 AM – 9 PM). The dispatcher checks before sending; reminders
  // that land outside the window are deferred until the next allowed
  // moment by skipping that tick (they retain status='pending' and
  // get retried on the next minute).
  quietHoursStart String   @default("21:00")
  quietHoursEnd   String   @default("08:00")
  // Off-by-default master switch for the booking-confirmation SMS
  // (the "Thanks for booking…" text that lands right after Mary
  // saves an appointment, before the 1-day / 2-hr / 30-min / start
  // cascade). Off by default so first-enable doesn't blast every
  // pre-existing appointment retroactively; admin flips it via
  // Settings, which also triggers a backfill that marks every
  // existing appointment's confirmation row 'skipped' so only
  // future bookings get the text.
  confirmationEnabled Boolean @default(false)
  // E.164 phone number to send SMS *from* (reminders + morning briefs).
  // Null = fall back to the GHL location's default number, which is
  // what every deployment did before this column existed. Setting it
  // explicitly lets the agency point reminder traffic at a dedicated
  // number distinct from internal / agent outbound.
  senderPhone     String?
  updatedAt       DateTime @updatedAt @default(now())
}

// -----------------------------------------------------------------------------
// End-of-day reports — submitted by agents at the end of each shift.
// One row per (agent, reportDate). Agents can re-open and update their own
// submission for the current day; staff view across all agents on
// /call-center. Fields mirror what Ethan asked for in the 2026-04-20 chat:
// dials, live contacts, appointments generated, issues faced, plus a bit
// more structured signal (callbacks, tech-issue tags) so patterns surface
// across days without requiring everyone to re-type the same complaints.
// -----------------------------------------------------------------------------

model EodReport {
  id                    String   @id @default(cuid())
  agentUserId           String
  agent                 User     @relation("AgentEodReports", fields: [agentUserId], references: [id], onDelete: Cascade)

  // Shift day (date-only in agent's local timezone). Stored as DATE so two
  // rows for the same calendar day can't exist for one agent.
  reportDate            DateTime @db.Date

  // Core metrics Ethan called out.
  dialsMade             Int      @default(0)
  contactsReached       Int      @default(0) // live conversations
  appointmentsGenerated Int      @default(0) // agent's own count; reconciled against Appointment table in UI
  callbacksScheduled    Int      @default(0)

  // Technical issue classification. Tags chosen from a known set in the UI
  // (dialer, CRM, Hub, call recording, connectivity, other); freeform notes
  // explain the specifics. Using String[] instead of a join table — we don't
  // need to query by tag at scale and this keeps the form dead simple.
  technicalIssueTags    String[]
  technicalIssueNotes   String?  @db.Text

  // Organizational / process blockers (leadership, shift handoff, unclear
  // scripts, script/offer confusion, etc.) — distinct from technical issues
  // so Ethan can see which bucket today's friction is actually in.
  organizationalIssues  String?  @db.Text

  // Free-form positives + forward-looking notes.
  wins                  String?  @db.Text
  tomorrowFocus         String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One report per agent per shift day. Agents can PATCH to edit it.
  @@unique([agentUserId, reportDate])
  @@index([reportDate])
}

// -----------------------------------------------------------------------------
// Callbacks — agent's personal follow-up list. Distinct from Appointment:
// a callback is a prospect to *call again later*, not a confirmed booking.
// Tracked per-agent; no staff rollup in v1 (this is the agent's own notebook,
// not a KPI for management). If a callback converts to an appointment, the
// agent books it normally and marks the callback done.
// -----------------------------------------------------------------------------

model Callback {
  id            String    @id @default(cuid())
  agentUserId   String
  agent         User      @relation("AgentCallbacks", fields: [agentUserId], references: [id], onDelete: Cascade)

  customerName  String
  customerPhone String
  // When the agent plans to call back (date + time).
  callbackAt    DateTime
  notes         String?   @db.Text

  // Set when the agent marks the callback as handled. Null = still pending.
  completedAt   DateTime?
  // Optional short outcome label when completing: "booked" | "not_interested"
  // | "no_answer" | "rescheduled" | "other". Kept as a free string for now so
  // we can refine the options after a week of real usage.
  outcome       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentUserId, callbackAt])
  @@index([agentUserId, completedAt])
}

// -----------------------------------------------------------------------------
// Per-user dismissal of a follow-up candidate. The /follow-ups view groups
// prospect threads (Gmail + GHL) into urgency buckets; clicking "Mark
// handled" writes a row here so the thread stops showing for that user.
// Threads are keyed by source-prefixed strings (e.g. "gmail:abc123",
// "ghl:xyz789") because cross-source identity collapse is brittle and we
// punted it for v1. New activity in the same thread doesn't auto-un-
// dismiss — admin removes the dismissal manually if they want it back
// (or we add an "include dismissed" toggle later).
// -----------------------------------------------------------------------------

model FollowUpDismissal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("FollowUpDismissals", fields: [userId], references: [id], onDelete: Cascade)
  /// Composite key — "gmail:{threadId}" / "ghl:{conversationId}".
  threadKey   String
  /// Snapshot of the contact at dismissal time, just so admin can recall
  /// what they marked handled without re-fetching the source thread.
  contactLabel String?
  /// Snooze expiry. NULL = permanent dismiss (never re-surface). When
  /// set, the unifier treats this dismissal as inactive once the
  /// timestamp passes — the row pops back into the follow-ups view
  /// for a fresh decision. Lets admin say "remind me in 3 days" /
  /// "1 week" instead of a binary mark-handled.
  snoozeUntil DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, threadKey], map: "ux_follow_up_dismissal_user_thread")
  @@index([userId])
  @@index([snoozeUntil])
}

// -----------------------------------------------------------------------------
// Slack alerts for inbound client messages on the Genisys GHL sub-account.
// One row per (conversation, GHL message id) we've alerted on. The cron
// scans /api/crm/client-conversations every minute, finds conversations
// whose lastMessageDate moved forward AND whose latest message is inbound,
// and posts to #genisys-alerts (or whatever channel is configured) so the
// team can respond faster. The unique (conversationId, lastMessageId) gate
// keeps duplicate ticks from re-alerting on the same message.
// -----------------------------------------------------------------------------

model ClientMessageAlert {
  id              String   @id @default(cuid())
  /// GHL conversation id (e.g. "A8SPqxrgMH0PGUHJzXFo").
  conversationId  String
  /// Linked Client (matched by phone/email/name in the alert sync). SET
  /// NULL on Client delete so historical alerts stay readable.
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// GHL message id we alerted on. Used as the dedup token — same
  /// conversation, same lastMessageId = same alert; skip.
  lastMessageId   String?
  lastMessageDate DateTime?
  /// Slack post tracking — channelId + messageTs let us optionally edit
  /// or thread-reply later if we ever want to acknowledge in-Slack.
  slackChannelId  String?
  slackMessageTs  String?
  permalink       String?
  alertedAt       DateTime @default(now())

  @@index([conversationId])
  @@index([clientId])
  @@unique([conversationId, lastMessageId], map: "ux_client_msg_alert_conv_msg")
}

/// Additional Google Sheets that feed the Master Tracker beyond the
/// primary "Master Table." Added so partner call centers (Yassin's
/// team for Forward Energy Solutions + Brighton Capital Solar, as of
/// 2026-05-13) can keep using their own sheets without us forcing a
/// format change on them.
///
/// Each row links a spreadsheet ID + tab title to a single Client.
/// Every appointment in that sheet is hard-attributed to that client
/// — no routing brain inference. Mary's master tracker hides these
/// rows (admin/member only), but all the same downstream pipelines
/// fire: customer SMS reminders, client SMS / Slack alerts, /clients
/// counts, the per-client tracker on /client.
///
/// `columnMappingKey` picks one of the named column-mapping presets
/// in lib/secondary-sheets.ts. Yassin's two sheets share an identical
/// 15-column layout ('yassin'); future partners with different layouts
/// just need a new preset added to that file.
model SecondarySheet {
  id               String   @id @default(cuid())
  /// Google Drive file ID (the long string in the sheet's URL after
  /// /spreadsheets/d/).
  spreadsheetId    String
  /// Specific tab inside the spreadsheet. Defaults to the first tab
  /// name when not provided; admins can override if a sheet has
  /// multiple relevant tabs.
  tabTitle         String   @default("Sheet1")
  /// Hard-attributed client. Every row in this sheet is treated as
  /// belonging to this client. SetNull on Client delete so the
  /// row stays for audit; sync skips orphaned SecondarySheet rows.
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Picks a column-mapping preset by name (see lib/secondary-sheets.ts).
  /// 'yassin' = Forward Energy + Brighton Capital layout (Lead Name /
  /// Phone / HO' Address / Appointment Date + Appt. Time / etc.).
  columnMappingKey String   @default("yassin")
  /// Set false to temporarily pause ingestion without deleting the row.
  enabled          Boolean  @default(true)
  /// Free-text label shown in the admin UI ("Yassin — Forward Energy").
  label            String?
  /// Admin who added the sheet. Null for seed rows.
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([spreadsheetId, tabTitle], map: "ux_secondary_sheet_sheet_tab")
  @@index([clientId])
  @@index([enabled])
}

/// Audit log of appointment edits. One row per save that actually
/// changed something — created on PATCH at /api/agent/appointments/[id]
/// (Hub form full edits) and /api/call-center/master-tracker/[rowNumber]
/// (inline status / sent-to-client / full-edit modal). Powers the
/// "Appointment edits" tab under /agents so Alex can see what Mary or
/// admin changed and when.
///
/// Snapshot fields (editorEmail / customerName / etc.) are stored so
/// the log renders correctly even after a User gets removed or an
/// Appointment row gets deleted — the FK relations use SetNull /
/// Cascade respectively but the snapshot stays put.
///
/// `changes` is a Prisma JSON column with shape:
///   { fieldName: { from: <old>, to: <new> } }
/// where values are stringified for display ("2026-05-13T16:00:00Z" ↔
/// "showed" ↔ "(480) 555-1234" all readable as-is).
model AppointmentEditLog {
  id              String   @id @default(cuid())
  /// Set when the edit targeted a DB Appointment row (Hub-form path,
  /// or master-tracker edit on a row that has an Appointment behind
  /// it). Null for sheet-only rows where no DB Appointment exists.
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  /// Sheet coordinates when the edit came through the master tracker.
  /// Both fields together identify a sheet row. Useful for sheet-only
  /// rows that don't have an appointmentId.
  sheetTabTitle   String?
  sheetRowNumber  Int?
  /// Linked client at the time of the edit (snapshot via the relation
  /// + clientName below in case the Client gets deleted).
  clientId        String?
  client          Client?  @relation("ClientAppointmentEdits", fields: [clientId], references: [id], onDelete: SetNull)
  clientName      String?
  /// Who made the edit. SetNull on User delete; editorEmail/Name
  /// snapshots below let the log keep rendering anyway.
  editorUserId    String?
  editor          User?    @relation("AppointmentEditor", fields: [editorUserId], references: [id], onDelete: SetNull)
  editorEmail     String?
  editorName      String?
  /// Snapshots for display so the log row reads naturally even after
  /// the underlying Appointment is gone.
  customerName    String?
  customerPhone   String?
  apptDateTime    DateTime?
  /// Where the edit happened: 'agent-form' (the Hub agent appointment
  /// form, full edit modal) or 'master-tracker' (the inline status /
  /// sent-to-client selects, or the master tracker's edit modal).
  source          String
  /// Compact JSON diff: { fieldName: { from, to } }. Only fields
  /// whose value actually changed are recorded — same-value writes
  /// don't log.
  changes         Json
  createdAt       DateTime @default(now())

  @@index([appointmentId])
  @@index([editorUserId])
  @@index([createdAt])
  @@index([clientId])
}

/// Internal team chat — replaces Microsoft Teams for Mary's
/// offshore agents. One channel per row; v1 ships with a single
/// "team-1-general" channel seeded on first deploy. Schema is
/// designed so future channels (per-team, admins-only, DMs)
/// require zero migration, only API + UI work.
model ChatChannel {
  id          String   @id @default(cuid())
  /// Stable slug used in URLs and seed-or-find logic. v1 uses
  /// "team-1-general"; future channels pick their own slug.
  slug        String   @unique
  /// Display label shown in the chat UI header.
  name        String
  /// Which Team #N this channel belongs to. teamNumber=1 + the
  /// seeded slug "team-1-general" is the one we ship with. Admin
  /// (role=admin/member) sees every channel regardless.
  teamNumber  Int
  createdAt   DateTime @default(now())

  messages    ChatMessage[]
}

/// One message in a ChatChannel. Sender snapshot (senderName +
/// senderImage) is denormalized at write time so chat history
/// reads cleanly even after the sender's User row is deleted —
/// same pattern SlackMessage uses for the Slack mirror cache.
model ChatMessage {
  id          String   @id @default(cuid())
  channelId   String
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Set when the sender's User row still exists. SetNull-on-delete
  /// keeps the message readable after a user is removed.
  senderId    String?
  sender      User?    @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  /// Snapshot of sender name at write time (e.g. "Maria Cruz").
  /// Survives senderId being nulled out. Required so the UI always
  /// has something to render.
  senderName  String
  /// Optional avatar URL snapshot. Null = UI falls back to the
  /// initials-based Avatar component.
  senderImage String?
  text        String   @db.Text
  createdAt   DateTime @default(now())

  attachments ChatAttachment[]

  @@index([channelId, createdAt])
}

/// Inline attachment (photo only for v1) attached to a ChatMessage.
/// Bytes are stored directly in Postgres bytea, mirroring the
/// Document model's approach. JPEG/PNG only, 5 MB cap enforced at
/// the upload route. Photos auto-expire after 30 days via a daily
/// scheduler tick (text history is retained indefinitely).
model ChatAttachment {
  id          String   @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  sizeBytes   Int
  content     Bytes
  createdAt   DateTime @default(now())

  @@index([messageId])
  /// Drives the daily expiration cron — partial index would be
  /// even cheaper, but this column appears in the cron's date
  /// filter every time, so a standalone index is the right tool.
  @@index([createdAt])
}

